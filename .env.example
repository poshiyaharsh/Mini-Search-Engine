# ====================================================================
# Mini Search Engine - Production Environment Variables Example
# ====================================================================

# Application Environment (development / production)
FLASK_ENV=production
FLASK_DEBUG=0

# Security Secret Key (Generate a random 32-byte secret hex string in production: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key

# Web Server Port (Defaults to 5000; Render / Railway provide $PORT automatically)
PORT=5000

# Database Connection URI (Defaults to SQLite at instance/app.db)
# To use Render Managed PostgreSQL, paste the database Internal URL:
# DATABASE_URL=postgresql://user:password@host/dbname

# Persistent Data Storage Directory (Optional: defaults to project root)
# If mounting a persistent disk (e.g. /var/data on Render or /data on Railway):
# DATA_DIR=/var/data

# ====================================================================
# Mini Search Engine - Git Ignore Rules
# ====================================================================

# Environment variables, keys, and secrets
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.cert
*.crt
config/secrets.*
secrets.*

# Python bytecode, builds, and distribution
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.Python
*.so
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Databases and persistent local data
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
instance/

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs and transient runtime files
*.log
/tmp/
tmp/
*.pid

# Test and code coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# Crawled web pages cache (directory preserved via .gitkeep)
crawled_pages/*.json
!crawled_pages/.gitkeep

# Graph analysis output and local scratch files
graphify-out/
scratch/
